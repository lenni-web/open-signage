#!/usr/bin/env bash
set -uo pipefail

readonly APP_DIR="/opt/open-signage"
readonly DATA_DIR="/var/lib/open-signage"
readonly CONFIG_FILE="/etc/default/open-signage-application-update"
readonly TRIGGER_FILE="${DATA_DIR}/application-update.request"
readonly STATUS_FILE="${DATA_DIR}/application-update.json"
readonly LOG_FILE="${DATA_DIR}/application-update.log"

write_status() {
  local status="$1" message="$2" started_at="$3" finished_at="$4"
  local temporary="${STATUS_FILE}.tmp"
  printf '{"status":"%s","message":"%s","started_at":%s,"finished_at":%s}\n' \
    "${status}" "${message}" "${started_at}" "${finished_at}" >"${temporary}"
  chown open-signage:open-signage "${temporary}"
  chmod 0640 "${temporary}"
  mv "${temporary}" "${STATUS_FILE}"
}

finish_failure() {
  local message="$1"
  write_status "failed" "${message}" "${started_at}" "\"$(date --iso-8601=seconds)\""
  chown open-signage:open-signage "${LOG_FILE}"
  exit 1
}

install -d -o open-signage -g open-signage -m 0750 "${DATA_DIR}"
rm -f "${TRIGGER_FILE}"
started_at="\"$(date --iso-8601=seconds)\""
write_status "running" "Neue Open-Signage-Version wird installiert." "${started_at}" "null"
touch "${LOG_FILE}"
chmod 0640 "${LOG_FILE}"

if [[ ! -r "${CONFIG_FILE}" ]]; then
  finish_failure "Updatekonfiguration fehlt. Installation erneut ausführen."
fi
# shellcheck source=/dev/null
source "${CONFIG_FILE}"
if [[ -z "${SOURCE_REPOSITORY:-}" || -z "${SOURCE_USER:-}" || -z "${PORT:-}" ]]; then
  finish_failure "Updatekonfiguration ist unvollständig."
fi
KIOSK_USER="${KIOSK_USER:-signage}"

(
  printf '\n===== Anwendungsupdate %s =====\n' "$(date --iso-8601=seconds)"
  printf 'Lade Release-Tags aus %s …\n' "${SOURCE_REPOSITORY}"
  runuser -u "${SOURCE_USER}" -- git -C "${SOURCE_REPOSITORY}" fetch --tags --prune origin
  latest_tag="$(runuser -u "${SOURCE_USER}" -- git -C "${SOURCE_REPOSITORY}" tag --list 'v[0-9]*' --sort=-v:refname | head -n1)"
  [[ -n "${latest_tag}" ]] || { printf 'Kein Release-Tag gefunden.\n'; exit 20; }
  current_version="$(${APP_DIR}/.venv/bin/python -c 'from open_signage.version import __version__; print(__version__)')"
  printf 'Installiert: v%s, verfügbar: %s\n' "${current_version}" "${latest_tag}"
  if dpkg --compare-versions "${latest_tag#v}" le "${current_version}"; then
    printf 'Open Signage ist bereits aktuell oder neuer als der letzte Release.\n'
    exit 10
  fi

  work_dir="$(mktemp -d /opt/open-signage-update.XXXXXX)"
  release_dir="${work_dir}/release"
  backup_dir="${work_dir}/previous"
  mkdir "${release_dir}"
  runuser -u "${SOURCE_USER}" -- git -C "${SOURCE_REPOSITORY}" archive "${latest_tag}" | tar -x -C "${release_dir}"
  python3 -m venv "${release_dir}/.venv"
  "${release_dir}/.venv/bin/python" -m pip install --upgrade pip
  "${release_dir}/.venv/bin/python" -m pip install "${release_dir}"

  if ! command -v cec-client >/dev/null 2>&1 || ! command -v wlopm >/dev/null 2>&1 || \
     ! dpkg-query -W -f='${Status}' locales 2>/dev/null | grep -q 'install ok installed'; then
    apt-get update
    apt-get install --no-install-recommends -y cec-utils locales wlopm
  fi
  if ! locale -a | grep -qi '^de_DE\.utf8$'; then
    sed -i 's/^# *\(de_DE.UTF-8 UTF-8\)/\1/' /etc/locale.gen
    locale-gen de_DE.UTF-8
  fi

  # Keep the privileged updater and its units in sync with the installed release.
  install -o root -g root -m 0755 \
    "${release_dir}/deploy/open-signage-application-update" \
    /usr/local/sbin/open-signage-application-update
  install -o root -g root -m 0644 \
    "${release_dir}/deploy/open-signage-application-update.service" \
    /etc/systemd/system/open-signage-application-update.service
  install -o root -g root -m 0644 \
    "${release_dir}/deploy/open-signage-application-update.path" \
    /etc/systemd/system/open-signage-application-update.path
  install -o root -g root -m 0755 \
    "${release_dir}/deploy/open-signage-system-action" \
    /usr/local/sbin/open-signage-system-action
  install -o root -g root -m 0644 \
    "${release_dir}/deploy/open-signage-system-action.service" \
    /etc/systemd/system/open-signage-system-action.service
  install -o root -g root -m 0644 \
    "${release_dir}/deploy/open-signage-system-action.path" \
    /etc/systemd/system/open-signage-system-action.path
  sed "s|@@KIOSK_USER@@|${KIOSK_USER}|g" \
    "${release_dir}/deploy/open-signage-display-control" \
    >/usr/local/sbin/open-signage-display-control
  chmod 0755 /usr/local/sbin/open-signage-display-control
  kiosk_home="$(getent passwd "${KIOSK_USER}" | cut -d: -f6)"
  [[ -n "${kiosk_home}" ]] || { printf 'Kiosk-Benutzer %s existiert nicht.\n' "${KIOSK_USER}"; exit 24; }
  sed \
    -e "s|@@PLAYER_URL@@|http://127.0.0.1:${PORT}/player|g" \
    -e "s|@@HEALTH_URL@@|http://127.0.0.1:${PORT}/api/health|g" \
    "${release_dir}/deploy/open-signage-kiosk" >/usr/local/bin/open-signage-kiosk
  chmod 0755 /usr/local/bin/open-signage-kiosk
  install -d -o root -g root -m 0755 /etc/chromium/policies/managed
  install -o root -g root -m 0644 \
    "${release_dir}/deploy/open-signage-chromium-policy.json" \
    /etc/chromium/policies/managed/open-signage.json
  autostart_dir="${kiosk_home}/.config/labwc"
  autostart_file="${autostart_dir}/autostart"
  install -d -o "${KIOSK_USER}" -g "${KIOSK_USER}" -m 0755 "${autostart_dir}"
  install -d -o "${KIOSK_USER}" -g "${KIOSK_USER}" -m 0755 "${kiosk_home}/.local/state/open-signage"
  touch "${autostart_file}"
  grep -q '^#!/bin/sh' "${autostart_file}" || sed -i '1i #!/bin/sh' "${autostart_file}"
  sed -i '\|^/usr/local/bin/open-signage-kiosk|d' "${autostart_file}"
  printf '/usr/local/bin/open-signage-kiosk >>%s 2>&1 &\n' \
    "${kiosk_home}/.local/state/open-signage/kiosk.log" >>"${autostart_file}"
  chown "${KIOSK_USER}:${KIOSK_USER}" "${autostart_file}"
  chmod 0755 "${autostart_file}"
  for unit in open-signage-display-control.service open-signage-display-control.path \
    open-signage-display-schedule.service open-signage-display-schedule.timer; do
    install -o root -g root -m 0644 "${release_dir}/deploy/${unit}" "/etc/systemd/system/${unit}"
  done
  systemctl daemon-reload
  systemctl enable --now open-signage-system-action.path
  systemctl enable --now open-signage-display-control.path
  systemctl enable --now open-signage-display-schedule.timer

  systemctl stop open-signage.service
  mv "${APP_DIR}" "${backup_dir}"
  mv "${release_dir}" "${APP_DIR}"
  systemctl start open-signage.service

  healthy=0
  for _ in {1..30}; do
    if curl --fail --silent --show-error "http://127.0.0.1:${PORT}/api/health" >/dev/null; then
      healthy=1
      break
    fi
    sleep 1
  done
  if ((healthy == 0)); then
    printf 'Healthcheck fehlgeschlagen, stelle vorige Version wieder her.\n'
    systemctl stop open-signage.service
    mv "${APP_DIR}" "${work_dir}/failed"
    mv "${backup_dir}" "${APP_DIR}"
    systemctl start open-signage.service
    exit 30
  fi
  rm -rf "${backup_dir}" "${work_dir}"
  printf 'Anwendungsupdate auf %s erfolgreich.\n' "${latest_tag}"
) >>"${LOG_FILE}" 2>&1
result=$?

case "${result}" in
  0) write_status "success" "Anwendungsupdate erfolgreich abgeschlossen." "${started_at}" "\"$(date --iso-8601=seconds)\"" ;;
  10) write_status "success" "Open Signage ist bereits aktuell." "${started_at}" "\"$(date --iso-8601=seconds)\"" ;;
  *) finish_failure "Anwendungsupdate fehlgeschlagen oder wurde zurückgerollt." ;;
esac
chown open-signage:open-signage "${LOG_FILE}"
