#!/usr/bin/env bash
# Richtet die Systemintegration einer Open-Signage-Version ein: Pakete,
# Systemdienste, privilegierte Hilfsskripte, Kiosk und Live-Server.
#
# Aufrufer:
# - der Installer bei der Erstinstallation (mit dem geklonten Repository),
# - der Anwendungsupdater vor dem Umschalten (mit der *neuen* Version).
# So bringt jede Version ihre eigene Systemintegration mit, und Installer und
# Updater bleiben identisch.
set -euo pipefail

readonly RELEASE_DIR="${1:?Release-Verzeichnis fehlt}"
readonly PORT="${PORT:?PORT fehlt}"
readonly KIOSK_USER="${KIOSK_USER:-signage}"

KIOSK_HOME="$(getent passwd "${KIOSK_USER}" | cut -d: -f6)"
[[ -n "${KIOSK_HOME}" ]] || { printf 'Kiosk-Benutzer %s existiert nicht.\n' "${KIOSK_USER}"; exit 24; }
readonly KIOSK_HOME

# --- Pakete, die spätere Versionen zusätzlich benötigen -----------------------
if ! command -v cec-client >/dev/null 2>&1 || ! command -v wlopm >/dev/null 2>&1 || \
   ! command -v wlr-randr >/dev/null 2>&1 || \
   ! command -v wtype >/dev/null 2>&1 || \
   ! dpkg-query -W -f='${Status}' locales 2>/dev/null | grep -q 'install ok installed'; then
  apt-get update
  apt-get install --no-install-recommends -y cec-utils locales wlr-randr wlopm wtype
fi
if ! locale -a | grep -qi '^de_DE\.utf8$'; then
  sed -i 's/^# *\(de_DE.UTF-8 UTF-8\)/\1/' /etc/locale.gen
  locale-gen de_DE.UTF-8
fi

# --- Open-Signage-Server ------------------------------------------------------
sed "s/@@PORT@@/${PORT}/g" \
  "${RELEASE_DIR}/deploy/open-signage.service" >/etc/systemd/system/open-signage.service
chmod 0644 /etc/systemd/system/open-signage.service

# --- Privilegierte Hilfsskripte und ihre Auslöser -----------------------------
install -o root -g root -m 0755 \
  "${RELEASE_DIR}/deploy/open-signage-system-update" /usr/local/sbin/open-signage-system-update
install -o root -g root -m 0755 \
  "${RELEASE_DIR}/deploy/open-signage-application-update" /usr/local/sbin/open-signage-application-update
install -o root -g root -m 0755 \
  "${RELEASE_DIR}/deploy/open-signage-system-action" /usr/local/sbin/open-signage-system-action
sed "s|@@KIOSK_USER@@|${KIOSK_USER}|g" \
  "${RELEASE_DIR}/deploy/open-signage-display-control" >/usr/local/sbin/open-signage-display-control
chmod 0755 /usr/local/sbin/open-signage-display-control
for unit in \
  open-signage-update.service open-signage-update.path \
  open-signage-application-update.service open-signage-application-update.path \
  open-signage-system-action.service open-signage-system-action.path \
  open-signage-display-control.service open-signage-display-control.path \
  open-signage-display-schedule.service open-signage-display-schedule.timer; do
  install -o root -g root -m 0644 "${RELEASE_DIR}/deploy/${unit}" "/etc/systemd/system/${unit}"
done

# --- Kiosk --------------------------------------------------------------------
sed \
  -e "s|@@PLAYER_URL@@|http://127.0.0.1:${PORT}/player|g" \
  -e "s|@@HEALTH_URL@@|http://127.0.0.1:${PORT}/api/health|g" \
  "${RELEASE_DIR}/deploy/open-signage-kiosk" >/usr/local/bin/open-signage-kiosk
chmod 0755 /usr/local/bin/open-signage-kiosk
install -o root -g root -m 0755 \
  "${RELEASE_DIR}/deploy/open-signage-cursor-guard" /usr/local/bin/open-signage-cursor-guard
install -d -o root -g root -m 0755 /etc/chromium/policies/managed
install -o root -g root -m 0644 \
  "${RELEASE_DIR}/deploy/open-signage-chromium-policy.json" \
  /etc/chromium/policies/managed/open-signage.json

AUTOSTART_DIR="${KIOSK_HOME}/.config/labwc"
AUTOSTART_FILE="${AUTOSTART_DIR}/autostart"
install -d -o "${KIOSK_USER}" -g "${KIOSK_USER}" -m 0755 "${AUTOSTART_DIR}"
install -o "${KIOSK_USER}" -g "${KIOSK_USER}" -m 0644 \
  "${RELEASE_DIR}/deploy/open-signage-labwc-rc.xml" "${AUTOSTART_DIR}/rc.xml"
install -d -o "${KIOSK_USER}" -g "${KIOSK_USER}" -m 0755 "${KIOSK_HOME}/.local/state/open-signage"
touch "${AUTOSTART_FILE}"
grep -q '^#!/bin/sh' "${AUTOSTART_FILE}" || sed -i '1i #!/bin/sh' "${AUTOSTART_FILE}"
sed -i '\|^/usr/local/bin/open-signage-kiosk|d' "${AUTOSTART_FILE}"
sed -i '\|^/usr/local/bin/open-signage-cursor-guard|d' "${AUTOSTART_FILE}"
printf '/usr/local/bin/open-signage-cursor-guard &\n' >>"${AUTOSTART_FILE}"
printf '/usr/local/bin/open-signage-kiosk >>%s 2>&1 &\n' \
  "${KIOSK_HOME}/.local/state/open-signage/kiosk.log" >>"${AUTOSTART_FILE}"
chown "${KIOSK_USER}:${KIOSK_USER}" "${AUTOSTART_FILE}"
chmod 0755 "${AUTOSTART_FILE}"

# --- Ton ausschließlich über HDMI --------------------------------------------
# Mit dem KMS-Grafiktreiber stellt vc4 den HDMI-Ton bereit; die analoge
# Kopfhörerbuchse wird abgeschaltet, damit Ton nicht unbemerkt dort landet.
BOOT_CONFIG=/boot/firmware/config.txt
[[ -f "${BOOT_CONFIG}" ]] || BOOT_CONFIG=/boot/config.txt
if [[ -f "${BOOT_CONFIG}" ]] && grep -q '^dtoverlay=vc4-kms-v3d' "${BOOT_CONFIG}"; then
  if grep -q '^dtparam=audio=on' "${BOOT_CONFIG}"; then
    sed -i 's/^dtparam=audio=on/dtparam=audio=off/' "${BOOT_CONFIG}"
    printf 'Analoge Tonausgabe abgeschaltet; wirksam nach dem nächsten Neustart.\n'
  elif ! grep -q '^dtparam=audio=off' "${BOOT_CONFIG}"; then
    printf '\n[all]\n# Open Signage: Ton ausschließlich über HDMI\ndtparam=audio=off\n' >>"${BOOT_CONFIG}"
    printf 'Analoge Tonausgabe abgeschaltet; wirksam nach dem nächsten Neustart.\n'
  fi
fi

# --- Dienste aktivieren -------------------------------------------------------
systemctl daemon-reload
for unit in open-signage-update.path open-signage-application-update.path \
  open-signage-system-action.path open-signage-display-control.path \
  open-signage-display-schedule.timer; do
  systemctl enable --now "${unit}"
done

# --- Live-Server (MediaMTX) ---------------------------------------------------
/usr/local/sbin/open-signage-system-action setup_live || \
  printf 'Warnung: Live-Server konnte nicht eingerichtet werden.\n'
