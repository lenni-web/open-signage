#!/usr/bin/env python3
"""Erstellt ein verkleinertes Bildschirmfoto des Kiosks für die Display-Übersicht des Controllers.

Läuft als root über open-signage-screenshot.path, sobald Open Signage eine Anfrage ablegt, und
ruft grim in der Wayland-Sitzung des Kioskbenutzers auf.
"""
from __future__ import annotations

import os
import pwd
import shutil
import subprocess
from pathlib import Path

DATA_DIR = Path("/var/lib/open-signage")
REQUEST = DATA_DIR / "screenshot-request"
TARGET = DATA_DIR / "screenshot.jpg"
ERROR = DATA_DIR / "screenshot-error"
KIOSK_USER = "@@KIOSK_USER@@"
# 1920×1080 wird auf 480×270 verkleinert: ein paar Dutzend Kilobyte, auf dem Pi in Sekundenbruchteilen.
SCALE = "0.25"
QUALITY = "70"  # nur für grim mit JPEG-Unterstützung
MAX_BYTES = 1024 * 1024


def hand_over(path: Path) -> None:
    os.chmod(path, 0o640)
    try:
        shutil.chown(path, user="open-signage", group="open-signage")
    except LookupError:
        pass


def fail(message: str) -> int:
    ERROR.write_text(message, encoding="utf-8")
    hand_over(ERROR)
    return 1


def _stderr(result: subprocess.CompletedProcess) -> str:
    return result.stderr.decode("utf-8", "replace").strip() or f"Exit-Code {result.returncode}"


def capture(grim: list[str]) -> tuple[bytes | None, str]:
    """Nimmt den Bildschirm verkleinert als JPEG auf.

    Der grim von Raspberry Pi OS ist ohne JPEG-Unterstützung gebaut; dann wird als PNG
    aufgenommen und mit ffmpeg nach JPEG umgewandelt.
    """
    direct = subprocess.run(grim + ["-t", "jpeg", "-q", QUALITY, "-s", SCALE, "-"],
                            capture_output=True, timeout=15, check=False)
    if direct.returncode == 0 and direct.stdout.startswith(b"\xff\xd8"):
        return (direct.stdout, "") if len(direct.stdout) <= MAX_BYTES else (None, "Bild zu groß")
    png = subprocess.run(grim + ["-t", "png", "-l", "1", "-s", SCALE, "-"],
                         capture_output=True, timeout=15, check=False)
    if png.returncode != 0 or not png.stdout.startswith(b"\x89PNG"):
        return None, _stderr(png)
    ffmpeg = shutil.which("ffmpeg")
    if not ffmpeg:
        return None, "ffmpeg fehlt für die Umwandlung nach JPEG."
    jpeg = subprocess.run(
        [ffmpeg, "-hide_banner", "-loglevel", "error", "-f", "png_pipe", "-i", "pipe:0", "-frames:v", "1",
         "-q:v", "5", "-f", "image2pipe", "-vcodec", "mjpeg", "pipe:1"],
        input=png.stdout, capture_output=True, timeout=15, check=False,
    )
    if jpeg.returncode != 0 or not jpeg.stdout.startswith(b"\xff\xd8"):
        return None, _stderr(jpeg)
    return (jpeg.stdout, "") if len(jpeg.stdout) <= MAX_BYTES else (None, "Bild zu groß")


def main() -> int:
    REQUEST.unlink(missing_ok=True)
    grim, runuser = shutil.which("grim"), shutil.which("runuser")
    if not grim or not runuser:
        return fail("grim ist nicht installiert.")
    try:
        account = pwd.getpwnam(KIOSK_USER)
    except KeyError:
        return fail(f"Kiosk-Benutzer {KIOSK_USER} wurde nicht gefunden.")
    runtime = Path(f"/run/user/{account.pw_uid}")
    sockets = sorted(path.name for path in runtime.glob("wayland-*") if not path.name.endswith(".lock"))
    environment = [runuser, "-u", KIOSK_USER, "--", "env", f"HOME={account.pw_dir}", f"XDG_RUNTIME_DIR={runtime}"]
    errors = []
    for socket in sockets:
        image, detail = capture(environment + [f"WAYLAND_DISPLAY={socket}", grim])
        if image:
            temporary = TARGET.with_suffix(".tmp")
            temporary.write_bytes(image)
            hand_over(temporary)
            temporary.replace(TARGET)
            ERROR.unlink(missing_ok=True)
            return 0
        errors.append(f"{socket}: {detail}")
    if not sockets:
        return fail("Keine aktive Wayland-Sitzung gefunden.")
    return fail("grim konnte kein Bildschirmfoto erstellen – " + "; ".join(errors)[:250])


if __name__ == "__main__":
    raise SystemExit(main())
