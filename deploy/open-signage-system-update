#!/usr/bin/env bash
set -uo pipefail

readonly DATA_DIR="/var/lib/open-signage"
readonly TRIGGER_FILE="${DATA_DIR}/update.request"
readonly STATUS_FILE="${DATA_DIR}/system-update.json"
readonly LOG_FILE="${DATA_DIR}/system-update.log"

write_status() {
  local status="$1"
  local message="$2"
  local started_at="$3"
  local finished_at="$4"
  local temporary="${STATUS_FILE}.tmp"

  printf '{"status":"%s","message":"%s","started_at":%s,"finished_at":%s}\n' \
    "${status}" \
    "${message}" \
    "${started_at}" \
    "${finished_at}" >"${temporary}"
  chmod 0644 "${temporary}"
  mv "${temporary}" "${STATUS_FILE}"
}

install -d -o open-signage -g open-signage -m 0750 "${DATA_DIR}"
rm -f "${TRIGGER_FILE}"
started_at="\"$(date --iso-8601=seconds)\""
write_status "running" "Systempakete werden aktualisiert." "${started_at}" "null"

{
  printf '\n===== Systemupdate %s =====\n' "$(date --iso-8601=seconds)"
  apt-get update && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y
} >>"${LOG_FILE}" 2>&1
result=$?

finished_at="\"$(date --iso-8601=seconds)\""
if ((result == 0)); then
  write_status "success" "Systemupdate erfolgreich abgeschlossen." "${started_at}" "${finished_at}"
else
  write_status "failed" "Systemupdate fehlgeschlagen. Details stehen im Protokoll." "${started_at}" "${finished_at}"
fi
chown open-signage:open-signage "${STATUS_FILE}" "${LOG_FILE}"
exit "${result}"
