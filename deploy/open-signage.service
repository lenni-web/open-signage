[Unit]
Description=Open Signage server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=open-signage
Group=open-signage
WorkingDirectory=/opt/open-signage
Environment=OPEN_SIGNAGE_DATA_DIR=/var/lib/open-signage
EnvironmentFile=-/etc/open-signage.env
# python -m statt bin/uvicorn: Konsolenskripte einer Python-Umgebung enthalten
# den absoluten Pfad, an dem sie gebaut wurden. Der Updater baut neue Versionen
# in einem temporären Ordner und verschiebt sie danach.
ExecStart=/opt/open-signage/.venv/bin/python -m uvicorn --app-dir /opt/open-signage/src open_signage.main:app --host 0.0.0.0 --port @@PORT@@
Restart=on-failure
RestartSec=3
TimeoutStopSec=15

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/open-signage

[Install]
WantedBy=multi-user.target
