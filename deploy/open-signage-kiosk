#!/usr/bin/env bash
set -uo pipefail

PLAYER_URL="@@PLAYER_URL@@"
HEALTH_URL="@@HEALTH_URL@@"
KIOSK_HOME="$(getent passwd "$(id -un)" | cut -d: -f6)"
[[ -n "${KIOSK_HOME}" && -d "${KIOSK_HOME}" ]] || {
  printf 'Kiosk-Home-Verzeichnis konnte nicht ermittelt werden.\n' >&2
  exit 1
}
export HOME="${KIOSK_HOME}"
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-${HOME}/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-${HOME}/.cache}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-${HOME}/.local/state}"
export LANG="de_DE.UTF-8"
export LC_ALL="de_DE.UTF-8"
export LANGUAGE="de_DE:de"
if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" && -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/bus" ]]; then
  export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/bus"
fi
PROFILE_DIR="${XDG_STATE_HOME}/open-signage/chromium-profile"
mkdir -p "${XDG_CONFIG_HOME}" "${XDG_CACHE_HOME}" "${PROFILE_DIR}"
cd "${HOME}"

# Ton über HDMI: Je nach Voreinstellung gibt der Raspberry Pi sonst über die
# Kopfhörerbuchse aus. Beim ersten Start zusätzlich volle Lautstärke, die
# Feinregelung erfolgt am Bildschirm.
prepare_audio() {
  command -v wpctl >/dev/null 2>&1 || return 0
  local marker="${XDG_STATE_HOME}/open-signage/audio-initialized" sink=""
  for _ in {1..30}; do
    sink="$(wpctl status 2>/dev/null | awk '
      /Sinks:/ { inside = 1; next }
      inside && /Sources:/ { exit }
      inside && /HDMI/ && match($0, /[0-9]+\./) { print substr($0, RSTART, RLENGTH - 1); exit }')"
    [[ -n "${sink}" ]] && break
    sleep 1
  done
  [[ -n "${sink}" ]] || return 0
  wpctl inspect @DEFAULT_AUDIO_SINK@ 2>/dev/null | grep -qi hdmi || wpctl set-default "${sink}"
  if [[ ! -e "${marker}" ]]; then
    wpctl set-volume "${sink}" 1.0 && wpctl set-mute "${sink}" 0 && touch "${marker}"
  fi
}
prepare_audio >/dev/null 2>&1 &

while true; do
  until curl --fail --silent --show-error --max-time 2 "${HEALTH_URL}" >/dev/null; do
    sleep 2
  done

  printf '%s Starte Chromium-Kiosk.\n' "$(date --iso-8601=seconds)"
  chromium \
    --ozone-platform=wayland \
    --lang=de-DE \
    --accept-lang=de-DE,de \
    --user-data-dir="${PROFILE_DIR}" \
    --kiosk \
    --noerrdialogs \
    --disable-infobars \
    --disable-session-crashed-bubble \
    --disable-crash-reporter \
    --disable-breakpad \
    --disable-background-networking \
    --disable-component-update \
    --disable-sync \
    --disable-translate \
    --disable-features=Translate,TranslateUI \
    --no-first-run \
    --password-store=basic \
    --autoplay-policy=no-user-gesture-required \
    "${PLAYER_URL}"
  exit_code=$?
  printf '%s Chromium wurde mit Status %s beendet; Neustart in 3 Sekunden.\n' \
    "$(date --iso-8601=seconds)" "${exit_code}" >&2
  sleep 3
done
