#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import pwd
import re
import shutil
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

DATA_DIR = Path("/var/lib/open-signage")
CONFIG = DATA_DIR / "display-control.json"
REQUEST = DATA_DIR / "display-control-request"
STATUS = DATA_DIR / "display-control-status.json"
DEFAULTS = {
    "cec_address": "0", "activate_source": True, "fallback_hdmi_signal": True,
    "resolution_mode": "1080p60",
    "transition_ms": 4000,
    "schedule_enabled": False, "schedule_entries": [],
}
KIOSK_USER = "@@KIOSK_USER@@"


def read_json(path: Path, fallback: dict) -> dict:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
        return {**fallback, **value} if isinstance(value, dict) else fallback.copy()
    except (OSError, ValueError):
        return fallback.copy()


def write_status(**values) -> None:
    current = read_json(STATUS, {})
    current.update(values, updated_at=datetime.now().astimezone().isoformat())
    temporary = STATUS.with_suffix(".tmp")
    temporary.write_text(json.dumps(current, ensure_ascii=False), encoding="utf-8")
    os.chmod(temporary, 0o640)
    try:
        shutil.chown(temporary, user="open-signage", group="open-signage")
    except LookupError:
        pass
    temporary.replace(STATUS)


def sanitized_config() -> dict:
    raw = read_json(CONFIG, DEFAULTS)
    address = str(raw.get("cec_address", "0")).upper()
    if not re.fullmatch(r"[0-9A-F]", address):
        address = "0"
    time_pattern = re.compile(r"(?:[01]\d|2[0-3]):[0-5]\d")
    entries = raw.get("schedule_entries")
    if not isinstance(entries, list):
        entries = []
    if not entries and "schedule_on" in raw:
        entries = [{"weekday": day, "on": raw.get("schedule_on"), "off": raw.get("schedule_off")}
                   for day in (raw.get("schedule_weekdays") or range(7))]
    clean_entries = []
    for entry in entries[:100]:
        if not isinstance(entry, dict) or not isinstance(entry.get("weekday"), int):
            continue
        day = entry["weekday"]
        on_time, off_time = entry.get("on"), entry.get("off")
        if not 0 <= day <= 6 or not isinstance(on_time, str) or not isinstance(off_time, str):
            continue
        if not time_pattern.fullmatch(on_time) or not time_pattern.fullmatch(off_time) or on_time == off_time:
            continue
        clean_entries.append({"weekday": day, "on": on_time, "off": off_time})
    return {
        "cec_address": address,
        "activate_source": raw.get("activate_source") is True,
        "fallback_hdmi_signal": raw.get("fallback_hdmi_signal") is True,
        "resolution_mode": raw.get("resolution_mode") if raw.get("resolution_mode") in {
            "auto", "1080p60", "1080p50", "720p60"
        } else "1080p60",
        "transition_ms": raw.get("transition_ms") if isinstance(raw.get("transition_ms"), int)
        and 1000 <= raw.get("transition_ms") <= 6000 else 4000,
        "schedule_enabled": raw.get("schedule_enabled") is True,
        "schedule_entries": sorted(clean_entries, key=lambda entry: (entry["weekday"], entry["on"], entry["off"])),
    }


def run(command: list[str], input_text: str | None = None) -> subprocess.CompletedProcess:
    return subprocess.run(command, input=input_text, text=True, capture_output=True, timeout=15, check=False)


def cec(command: str, device: str | None = None, require_response: bool = False) -> tuple[bool, str]:
    executable = shutil.which("cec-client")
    if not executable:
        return False, "cec-client ist nicht installiert."
    args = [executable, "-s", "-d", "1"]
    if device:
        args.append(device)
    result = run(args, command + "\n")
    output = (result.stdout + "\n" + result.stderr).strip()
    lowered = output.lower()
    unavailable = any(marker in lowered for marker in (
        "no device found", "unable to open", "cannot open", "failed to open", "connection lost",
        "cec_transmit failed", "ioctl cec_transmit failed", "tx_status=00",
        "transmit failed", "failed to transmit",
    ))
    if require_response and "power status:" not in lowered:
        unavailable = True
    return result.returncode == 0 and not unavailable, output


def cec_adapter(address: str) -> tuple[str | None, str]:
    devices = [str(path) for path in sorted(Path("/dev").glob("cec*"))] or [None]
    messages = []
    for device in devices:
        ok, output = cec(f"pow {address}", device, require_response=True)
        messages.append(f"{device or 'Standardadapter'}: {output[-300:]}")
        if ok:
            return device or "", output
    return None, "\n".join(messages)


def cec_power_state(address: str, device: str | None) -> tuple[str, str]:
    ok, output = cec(f"pow {address}", device, require_response=True)
    if not ok:
        return "unknown", output
    lowered = output.lower()
    if "power status: on" in lowered:
        return "on", output
    if "power status: standby" in lowered:
        return "off", output
    return "unknown", output


def connected_outputs() -> list[str]:
    outputs = []
    for status in sorted(Path("/sys/class/drm").glob("card*-*/status")):
        try:
            if status.read_text(encoding="utf-8").strip() != "connected":
                continue
        except OSError:
            continue
        name = status.parent.name
        match = re.match(r"card\d+-(.+)", name)
        if match:
            outputs.append(match.group(1))
    return outputs


def wayland_signal(on: bool | None) -> tuple[bool, str, str | None]:
    executable = shutil.which("wlopm")
    runuser = shutil.which("runuser")
    if not executable or not runuser:
        return False, "wlopm ist nicht installiert.", None
    try:
        account = pwd.getpwnam(KIOSK_USER)
    except KeyError:
        return False, f"Kiosk-Benutzer {KIOSK_USER} wurde nicht gefunden.", None
    runtime = Path(f"/run/user/{account.pw_uid}")
    sockets = sorted(path.name for path in runtime.glob("wayland-*") if not path.name.endswith(".lock"))
    if not sockets:
        return False, "Keine aktive Wayland-Sitzung gefunden.", None
    preferred = connected_outputs()
    errors = []
    for socket in sockets:
        environment = [
            runuser, "-u", KIOSK_USER, "--", "env",
            f"HOME={account.pw_dir}", f"XDG_RUNTIME_DIR={runtime}",
            f"WAYLAND_DISPLAY={socket}",
            f"DBUS_SESSION_BUS_ADDRESS=unix:path={runtime}/bus",
        ]
        listed = run(environment + [executable])
        listing = (listed.stdout + listed.stderr).strip()
        if listed.returncode != 0:
            errors.append(listing)
            continue
        states = {}
        for line in listing.splitlines():
            match = re.match(r"^\s*(\S+):?\s+(on|off)\s*$", line, re.IGNORECASE)
            if match:
                states[match.group(1)] = match.group(2).lower()
        output_name = next((name for name in preferred if name in states), None)
        output_name = output_name or next(iter(states), None) or (preferred[0] if preferred else None)
        if not output_name:
            errors.append(f"{socket}: Kein Wayland-Ausgang gefunden. {listing}")
            continue
        if on is None:
            return True, listing or f"{output_name}: Status verfügbar", output_name
        result = run(environment + [executable, "--on" if on else "--off", output_name])
        output = (result.stdout + result.stderr).strip()
        if result.returncode == 0:
            return True, output or f"{output_name} wurde {'aktiviert' if on else 'deaktiviert'}.", output_name
        errors.append(f"{socket}/{output_name}: {output}")
    return False, "\n".join(errors) or "Wayland-Ausgang konnte nicht gesteuert werden.", None


def wayland_resolution(mode: str) -> tuple[bool, str, str | None, str | None]:
    executable = shutil.which("wlr-randr")
    runuser = shutil.which("runuser")
    if not executable or not runuser:
        return False, "wlr-randr ist nicht installiert.", None, None
    try:
        account = pwd.getpwnam(KIOSK_USER)
    except KeyError:
        return False, f"Kiosk-Benutzer {KIOSK_USER} wurde nicht gefunden.", None, None
    runtime = Path(f"/run/user/{account.pw_uid}")
    sockets = sorted(path.name for path in runtime.glob("wayland-*") if not path.name.endswith(".lock"))
    targets = {"1080p60": ("1920x1080", 60.0), "1080p50": ("1920x1080", 50.0),
               "720p60": ("1280x720", 60.0)}
    errors = []
    for socket in sockets:
        environment = [runuser, "-u", KIOSK_USER, "--", "env", f"HOME={account.pw_dir}",
                       f"XDG_RUNTIME_DIR={runtime}", f"WAYLAND_DISPLAY={socket}",
                       f"DBUS_SESSION_BUS_ADDRESS=unix:path={runtime}/bus"]
        listed = run(environment + [executable])
        listing = (listed.stdout + listed.stderr).strip()
        if listed.returncode != 0:
            errors.append(f"{socket}: {listing}")
            continue
        blocks = re.split(r"(?m)^(?=\S)", listing)
        preferred_outputs = connected_outputs()
        parsed = []
        for block in blocks:
            header = re.match(r"^(\S+)", block)
            if not header:
                continue
            output_name = header.group(1)
            current_match = re.search(r"(?m)^\s+(\d+x\d+) px,\s*([\d.]+) Hz.*\(.*current.*\)", block)
            preferred_match = re.search(r"(?m)^\s+(\d+x\d+) px,\s*([\d.]+) Hz.*\(.*preferred.*\)", block)
            modes = [(match.group(1), float(match.group(2))) for match in
                     re.finditer(r"(?m)^\s+(\d+x\d+) px,\s*([\d.]+) Hz", block)]
            parsed.append((output_name, current_match, preferred_match, modes))
        selected = next((item for name in preferred_outputs for item in parsed if item[0] == name), None)
        selected = selected or (parsed[0] if parsed else None)
        if not selected:
            errors.append(f"{socket}: Kein Ausgang erkannt.")
            continue
        output_name, current_match, preferred_match, modes = selected
        current = f"{current_match.group(1)} @ {float(current_match.group(2)):g} Hz" if current_match else None
        requested = targets.get(mode)
        chosen = None if requested is None else next(
            ((size, refresh) for size, refresh in modes
             if size == requested[0] and abs(refresh - requested[1]) < 0.2), None
        )
        fallback = requested is not None and chosen is None
        if requested is None or fallback:
            if not preferred_match:
                return False, "Bevorzugter Bildschirmmodus konnte nicht ermittelt werden.", output_name, current
            chosen = (preferred_match.group(1), float(preferred_match.group(2)))
        desired = f"{chosen[0]} @ {chosen[1]:g} Hz"
        if current_match and current_match.group(1) == chosen[0] and abs(float(current_match.group(2)) - chosen[1]) < 0.01:
            message = "Gewählter Modus ist bereits aktiv."
            if fallback:
                message = "Gewählter Modus wird nicht unterstützt; bevorzugter Modus ist bereits aktiv."
            return True, message, output_name, current
        result = run(environment + [executable, "--output", output_name, "--mode",
                                    f"{chosen[0]}@{chosen[1]:g}Hz"])
        result_output = (result.stdout + result.stderr).strip()
        if result.returncode == 0:
            message = f"Auf {desired} umgestellt."
            if fallback:
                message = f"Gewählter Modus wird nicht unterstützt; auf bevorzugten Modus {desired} zurückgefallen."
            return True, message, output_name, desired
        errors.append(f"{socket}/{output_name}: {result_output}")
    return False, " ".join(errors) or "Keine aktive Wayland-Sitzung gefunden.", None, None


def scheduled_state(config: dict, now: datetime) -> str | None:
    if not config.get("schedule_enabled"):
        return None
    current = now.strftime("%H:%M")
    entries = config.get("schedule_entries") or []
    active = False
    for entry in entries:
        day, on_time, off_time = entry["weekday"], entry["on"], entry["off"]
        if on_time < off_time:
            active = active or (now.weekday() == day and on_time <= current < off_time)
        else:
            active = active or ((now.weekday() == day and current >= on_time) or
                                (now.weekday() == (day + 1) % 7 and current < off_time))
    return "on" if active else "off"


def execute(action: str, config: dict) -> None:
    if action == "resolution":
        resolution_ok, resolution_message, output_name, current_resolution = wayland_resolution(
            config.get("resolution_mode", "1080p60")
        )
        write_status(output_name=output_name, resolution_mode=config.get("resolution_mode"),
                     current_resolution=current_resolution, resolution_message=resolution_message,
                     message=("Auflösung angewendet. " if resolution_ok else "Auflösung konnte nicht angewendet werden. ")
                     + resolution_message)
        return
    address = config.get("cec_address", "0")
    adapter, probe_output = cec_adapter(address)
    fallback_available, fallback_status, fallback_output = wayland_signal(None)
    if action == "status":
        cec_available = adapter is not None
        output = probe_output
        lowered = probe_output.lower()
        power = "on" if "power status: on" in lowered else "off" if "power status: standby" in lowered else "unknown"
        method = "cec" if cec_available and power != "unknown" else None
        if method is None and config.get("fallback_hdmi_signal"):
            if fallback_available:
                lowered_fallback = fallback_status.lower()
                power = "off" if re.search(rf"^{re.escape(fallback_output or '')}:?\s+off\s*$", lowered_fallback, re.MULTILINE | re.IGNORECASE) else "on"
                method, output = "wayland_dpms", fallback_status
        resolution_ok, resolution_message, resolution_output, current_resolution = wayland_resolution(
            config.get("resolution_mode", "1080p60")
        )
        write_status(cec_available=cec_available, hdmi_fallback_available=fallback_available,
                     power_status=power, method=method, cec_adapter=adapter,
                     output_name=resolution_output or fallback_output,
                     resolution_mode=config.get("resolution_mode"), current_resolution=current_resolution,
                     resolution_message=resolution_message,
                     message=output[-500:] or "Status abgefragt.")
        return

    turn_on = action == "on"
    cec_command = f"on {address}" if turn_on else f"standby {address}"
    cec_ok, cec_output = cec(cec_command, adapter or None) if adapter is not None else (False, probe_output)
    ok, output = cec_ok, cec_output
    cec_available = adapter is not None
    method = "cec" if cec_ok else None
    if cec_ok and turn_on and config.get("activate_source"):
        source_ok, source_output = cec("as", adapter)
        ok = ok and source_ok
        output = f"{output}\n{source_output}".strip()
    if ok:
        time.sleep(1)
        confirmed_state, confirmation_output = cec_power_state(address, adapter or None)
        expected_state = "on" if turn_on else "off"
        ok = confirmed_state == expected_state
        output = f"{output}\nCEC-Rückprüfung: {confirmation_output}".strip()
        if not ok:
            output = (
                f"{output}\nCEC meldet nach der Aktion {confirmed_state!r} statt "
                f"{expected_state!r}; die Aktion gilt als nicht ausgeführt."
            )
    if not ok and config.get("fallback_hdmi_signal"):
        fallback_ok, fallback_message, fallback_output = wayland_signal(turn_on)
        ok = fallback_ok
        method = "wayland_dpms" if fallback_ok else None
        output = f"CEC nicht verfügbar: {output[-500:]}\nWayland-DPMS: {fallback_message}".strip()
    if ok and method == "cec":
        summary = "CEC-Aktion erfolgreich ausgeführt. "
    elif ok and method == "wayland_dpms":
        summary = "CEC nicht erreichbar; Wayland-DPMS-Fallback ausgeführt. "
    else:
        summary = "Bildschirmaktion fehlgeschlagen. "
    resolution_message = None
    current_resolution = None
    if ok and turn_on:
        resolution_ok, resolution_message, resolution_output, current_resolution = wayland_resolution(
            config.get("resolution_mode", "1080p60")
        )
        fallback_output = resolution_output or fallback_output
        if not resolution_ok:
            output = f"{output}\nAuflösung: {resolution_message}".strip()
    status_values = {
        "cec_available": cec_available, "hdmi_fallback_available": fallback_available,
        "power_status": action if ok else "unknown", "desired_state": action,
        "method": method, "cec_adapter": adapter, "output_name": fallback_output,
        "message": summary + output[-500:],
    }
    if turn_on:
        status_values.update(resolution_mode=config.get("resolution_mode"),
                             current_resolution=current_resolution,
                             resolution_message=resolution_message)
    write_status(**status_values)


def main() -> int:
    config = sanitized_config()
    if "--schedule" in sys.argv:
        action = scheduled_state(config, datetime.now().astimezone())
        if action != "off":
            execute("resolution", config)
        if action is None:
            return 0
        previous = read_json(STATUS, {}).get("desired_state")
        # Ein eingeschalteter Ausgang muss nicht minütlich erneut aktiviert
        # werden. Den ausgeschalteten Zustand setzen wir dagegen erneut durch,
        # weil HDMI-Hotplug oder Eingabeereignisse Wayland-DPMS wecken können.
        if previous == action == "on":
            return 0
    else:
        try:
            action = REQUEST.read_text(encoding="utf-8").strip()
        except OSError:
            return 0
        REQUEST.unlink(missing_ok=True)
    if action not in {"on", "off", "status", "resolution"}:
        write_status(message="Ungültige Display-Aktion verworfen.", power_status="unknown")
        return 2
    execute(action, config)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
